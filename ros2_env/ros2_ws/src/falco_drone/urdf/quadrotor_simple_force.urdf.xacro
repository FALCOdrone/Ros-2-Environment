<?xml version="1.0"?>

<robot name="quadrotor_simple" xmlns:xacro="http://wiki.ros.org/xacro" >

    <!-- Declare the 'id' argument -->
    <xacro:arg name="id" default="0"/>

    <!-- Use the argument -->
    <xacro:property name="ID" value="$(arg id)" />
    <xacro:property name="robot_name" value="quadrotor_$(arg id)" />

    <xacro:property name="M_PI" value="3.1415926535897931" />
    
    <!-- Main quadrotor body -->
    <link name="base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1.477" />
        <inertia ixx="0.01152" ixy="0.0" ixz="0.0" iyy="0.01152" iyz="0.0" izz="0.0218" />
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://falco_drone/meshes/quadrotor/quadrotor_base.dae"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://falco_drone/meshes/quadrotor/quadrotor_base.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- Simple Gazebo plugins for basic functionality -->
    <gazebo>
      <!-- Physics system -->
      <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      </plugin>
      
      <!-- Apply forces and torques to the base link -->
      <plugin filename="gz-sim-apply-link-wrench-system" 
              name="gz::sim::systems::ApplyLinkWrench">
      </plugin>
      
      <!-- User commands system -->
      <plugin filename="gz-sim-user-commands-system" 
              name="gz::sim::systems::UserCommands">
      </plugin>
    </gazebo>

    <!-- IMU sensor link -->
    <link name="imu_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
    <!-- IMU sensor -->
    <gazebo reference="imu_link">
      <sensor type="imu" name="imu_sensor">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
          <topic>/${robot_name}/imu</topic>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Forward facing camera -->  
    <xacro:include filename="$(find falco_drone)/urdf/sensors/generic_camera.urdf.xacro" />
    <xacro:generic_camera name="front" robot_name="${robot_name}" parent="base_link" update_rate="60" res_x="640" res_y="360" image_format="R8G8B8" hfov="${81*M_PI/180}">
      <origin xyz="0.21 0.0 0.01" rpy="0 0 0"/>
    </xacro:generic_camera>
    
</robot>
