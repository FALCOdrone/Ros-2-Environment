<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro" >

  <!-- Simple force-based controller for ROS2/Gazebo -->
  <xacro:macro name="quadrotor_simple_force_controller" params="robot_name">
    <gazebo>
      <!-- Physics engine -->
      <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      </plugin>
      
      <!-- Apply forces and torques to the base link -->
      <plugin filename="gz-sim-apply-link-wrench-system" 
              name="gz::sim::systems::ApplyLinkWrench">
      </plugin>
      
      <!-- Simple force commands -->
      <plugin filename="gz-sim-triggered-publisher-system"
              name="gz::sim::systems::TriggeredPublisher">
        <input type="gz.msgs.Twist" topic="/${robot_name}/cmd_vel">
        </input>
        <output type="gz.msgs.Wrench" topic="/model/${robot_name}/link/base_link/wrench">
          <force>${force.x * 10} ${force.y * 10} ${force.z * 20}</force>
          <torque>0 0 ${torque.z * 5}</torque>
        </output>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
