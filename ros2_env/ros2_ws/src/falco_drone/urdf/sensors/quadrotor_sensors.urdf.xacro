<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro" >

  <xacro:macro name="quadrotor_sensors" params="robot_name">
    <gazebo>
      <!-- IMU sensor -->
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        <topic>/${robot_name}/imu</topic>
        <enable_orientation>true</enable_orientation>
      </plugin>
      
      <!-- Odometry/Ground truth -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>${robot_name}/odom</odom_frame>
        <robot_base_frame>${robot_name}/base_link</robot_base_frame>
        <odom_topic>/${robot_name}/ground_truth/state</odom_topic>
        <odom_publish_frequency>100</odom_publish_frequency>
      </plugin>
    </gazebo>
    
    <!-- IMU sensor link and joint -->
    <link name="imu_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
    <gazebo reference="imu_link">
      <sensor type="imu" name="imu_sensor">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
          <topic>/${robot_name}/imu</topic>
          <enable_orientation>true</enable_orientation>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
