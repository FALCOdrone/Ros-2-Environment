<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro" >
  
  <!-- Quadrotor base with motor links for Ignition Gazebo -->
  <xacro:macro name="quadrotor_base_with_motors"> 
    <!-- Main quadrotor body -->
    <link name="base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1.477" />
        <inertia ixx="0.01152" ixy="0.0" ixz="0.0" iyy="0.01152" iyz="0.0" izz="0.0218" />
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://falco_drone/meshes/quadrotor/quadrotor_base.dae"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://falco_drone/meshes/quadrotor/quadrotor_base.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- Motor properties -->
    <xacro:property name="rotor_inertia">
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002" />
    </xacro:property>

    <!-- Motor macro -->
    <xacro:macro name="rotor" params="suffix x y z">
      <link name="rotor_${suffix}">
        <inertial>
          <mass value="0.025" />
          <origin xyz="0 0 0" />
          <xacro:insert_block name="rotor_inertia" />
        </inertial>
        <visual>
          <geometry>
            <cylinder length="0.005" radius="0.1"/>
          </geometry>
          <material name="Blue">
            <color rgba="0.0 0.0 1.0 1.0" />
          </material>
        </visual>
        <collision>
          <geometry>
            <cylinder length="0.005" radius="0.1"/>
          </geometry>
        </collision>
      </link>

      <joint name="rotor_${suffix}_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rotor_${suffix}"/>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <dynamics damping="0.004" friction="0.000" />
      </joint>
    </xacro:macro>

    <!-- Create 4 rotors in X configuration -->
    <xacro:rotor suffix="0" x="0.13" y="0.22" z="0.023" />   <!-- Front right -->
    <xacro:rotor suffix="1" x="-0.13" y="-0.22" z="0.023" /> <!-- Back left -->
    <xacro:rotor suffix="2" x="0.13" y="-0.22" z="0.023" />  <!-- Front left -->
    <xacro:rotor suffix="3" x="-0.13" y="0.22" z="0.023" />  <!-- Back right -->

  </xacro:macro>
</robot>
