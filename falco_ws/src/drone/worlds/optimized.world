<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="empty">

    <!-- 1) Your scene tweaks (disable shadows, grid, etc.) -->
    <scene>
      <shadows>0</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <!-- 2) Your physics tweaks go here: -->
    <physics name="default_physics" type="ode">
      <!-- make the physics step coarser for less CPU load -->
      <max_step_size>0.005</max_step_size>
      <!-- fewer solver iterations per second -->
      <real_time_update_rate>200</real_time_update_rate>
      <!-- if you’d rather run “as fast as possible”, use this instead:
      <real_time_update_rate>0</real_time_update_rate>
      -->
    </physics>

    <!-- 3) (Optional) other world elements like lights, models, etc. -->

  </world>
</sdf>