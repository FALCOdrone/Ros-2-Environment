<?xml version="1.0"?>
<model>
  <name>x500_enhanced</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  
  <author>
    <name>Generated for Drone Control Project</name>
    <email>your-email@example.com</email>
  </author>
  
  <description>
    Enhanced X500 quadcopter based on the official PX4 x500 model with added stereo cameras and GPS.
    
    Included from x500 base:
    - Complete quadcopter physics and dynamics
    - IMU sensor for attitude and acceleration
    - Air pressure sensor for altitude
    
    Additional sensors:
    - GPS/NavSat sensor positioned on top of drone
    - Left camera for stereo vision (8cm forward, 2.5cm left, 2cm up)
    - Right camera for stereo vision (8cm forward, 2.5cm right, 2cm up)
    
    Sensor positioning is optimized for:
    - GPS: Clear sky access on top of drone
    - Stereo cameras: 5cm baseline for depth perception
    - All sensors properly attached to drone structure
    
    Perfect for autonomous navigation, stereo vision, and visual odometry applications.
  </description>
  
  <dependencies>
    <dependency>
      <uri>model://x500</uri>
    </dependency>
  </dependencies>
</model>
