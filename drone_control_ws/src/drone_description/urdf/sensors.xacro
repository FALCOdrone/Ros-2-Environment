<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- IMU Sensor -->
  <xacro:macro name="imu_sensor" params="parent">
    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.01"/>
        </geometry>
        <material name="green">
          <color rgba="0.1 0.8 0.1 1"/>
        </material>
      </visual>
    </link>
    
    <joint name="imu_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>
    
    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <plugin name="gz::sim::systems::ImuSystem" filename="gz-sim-imu-system"/>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Sonar Sensor (pointing down) -->
  <xacro:macro name="sonar_sensor" params="parent">
    <link name="sonar_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.03"/>
        </geometry>
        <material name="yellow">
          <color rgba="0.8 0.8 0.1 1"/>
        </material>
      </visual>
    </link>
    
    <joint name="sonar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="sonar_link"/>
      <origin xyz="0 0 -0.08" rpy="0 ${pi/2} 0"/>
    </joint>
    
    <gazebo reference="sonar_link">
      <sensor name="sonar_sensor" type="ray">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <plugin name="gz::sim::systems::RaySystem" filename="gz-sim-ray-system"/>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Front Camera -->
  <xacro:macro name="camera_sensor" params="parent">
    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.03 0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
    </link>
    
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
    </joint>
    
    <gazebo reference="camera_link">
      <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="gz::sim::systems::CameraSystem" filename="gz-sim-camera-system"/>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Barometer Sensor -->
  <xacro:macro name="barometer_sensor" params="parent">
    <link name="barometer_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.015 0.005"/>
        </geometry>
        <material name="purple">
          <color rgba="0.8 0.1 0.8 1"/>
        </material>
      </visual>
    </link>
    
    <joint name="barometer_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="barometer_link"/>
      <origin xyz="0.05 0.05 0.02" rpy="0 0 0"/>
    </joint>
    
    <!-- Barometer plugin will be implemented in ROS2 node -->
  </xacro:macro>

  <!-- Magnetometer Sensor -->
  <xacro:macro name="magnetometer_sensor" params="parent">
    <link name="magnetometer_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.005"/>
        </geometry>
        <material name="orange">
          <color rgba="0.8 0.5 0.1 1"/>
        </material>
      </visual>
    </link>
    
    <joint name="magnetometer_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="magnetometer_link"/>
      <origin xyz="-0.05 0.05 0.02" rpy="0 0 0"/>
    </joint>
    
    <!-- Magnetometer plugin will be implemented in ROS2 node -->
  </xacro:macro>

</robot>
