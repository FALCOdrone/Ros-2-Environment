<?xml version="1.0"?>
<robot name="quadrotor_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define properties -->
  <xacro:property name="mass" value="1.0" />
  <xacro:property name="body_width" value="0.3" />
  <xacro:property name="body_height" value="0.15" />
  <xacro:property name="arm_length" value="0.25" />
  <xacro:property name="prop_radius" value="0.1" />
  
  <!-- Inertia values -->
  <xacro:property name="ixx" value="0.0347563" />
  <xacro:property name="iyy" value="0.0458929" />
  <xacro:property name="izz" value="0.0977" />

  <!-- Include sensor macros -->
  <xacro:include filename="$(find drone_description)/urdf/sensors.xacro" />

  <!-- Base link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_width} ${body_width} ${body_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_width} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Front left arm -->
  <link name="front_left_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${arm_length}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${arm_length}"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_arm_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_arm"/>
    <origin xyz="${arm_length/2} ${arm_length/2} 0" rpy="0 0 ${pi/4}"/>
  </joint>

  <!-- Front right arm -->
  <link name="front_right_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${arm_length}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${arm_length}"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_arm_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_arm"/>
    <origin xyz="${arm_length/2} ${-arm_length/2} 0" rpy="0 0 ${-pi/4}"/>
  </joint>

  <!-- Back left arm -->
  <link name="back_left_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${arm_length}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${arm_length}"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_arm_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_left_arm"/>
    <origin xyz="${-arm_length/2} ${arm_length/2} 0" rpy="0 0 ${3*pi/4}"/>
  </joint>

  <!-- Back right arm -->
  <link name="back_right_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${arm_length}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${arm_length}"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_arm_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_right_arm"/>
    <origin xyz="${-arm_length/2} ${-arm_length/2} 0" rpy="0 0 ${-3*pi/4}"/>
  </joint>

  <!-- Propellers -->
  <xacro:macro name="propeller" params="name x y">
    <link name="${name}_propeller">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${prop_radius}" length="0.01"/>
        </geometry>
        <material name="blue">
          <color rgba="0.1 0.1 0.8 1"/>
        </material>
      </visual>
    </link>
    
    <joint name="${name}_propeller_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_propeller"/>
      <origin xyz="${x} ${y} ${body_height/2 + 0.05}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:propeller name="front_left" x="${arm_length/2}" y="${arm_length/2}" />
  <xacro:propeller name="front_right" x="${arm_length/2}" y="${-arm_length/2}" />
  <xacro:propeller name="back_left" x="${-arm_length/2}" y="${arm_length/2}" />
  <xacro:propeller name="back_right" x="${-arm_length/2}" y="${-arm_length/2}" />

  <!-- Add sensors -->
  <xacro:imu_sensor parent="base_link" />
  <xacro:sonar_sensor parent="base_link" />
  <xacro:camera_sensor parent="base_link" />
  <xacro:barometer_sensor parent="base_link" />
  <xacro:magnetometer_sensor parent="base_link" />

  <!-- Gazebo specific properties -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo>

  <!-- Gazebo materials -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="front_left_arm">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="front_right_arm">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="back_left_arm">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="back_right_arm">
    <material>Gazebo/Red</material>
  </gazebo>

</robot>
