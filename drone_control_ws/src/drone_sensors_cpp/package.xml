  <version>0.0.0</version>
  <description>C++ sensor simulation nodes for quadrotor drone</description>
  <maintainer email="lorenzo@example.com">Lorenzo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
