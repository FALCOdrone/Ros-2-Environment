FROM osrf/ros:humble-desktop-full

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV SHELL=/bin/bash
ENV PX4_HOME=/opt/px4

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    vim \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    lsb-release \
    gnupg \
    software-properties-common \
    ninja-build \
    protobuf-compiler \
    libprotobuf-dev \
    python3-jinja2 \
    python3-numpy \
    python3-yaml \
    python3-setuptools \
    python3-empy \
    python3-toml \
    python3-packaging \
    python3-jsonschema \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libxml2-dev \
    libxml2-utils \
    libtinyxml2-dev \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install PX4 Python dependencies
RUN pip3 install --user kconfiglib pyros-genmsg empy jinja2 packaging toml jsonschema future

# Install Gazebo Classic (available for Ubuntu 22.04)
RUN apt-get update && apt-get install -y \
        gazebo \
        libgazebo-dev \
        gazebo-plugin-base \
    && rm -rf /var/lib/apt/lists/*

# Install MAVROS for PX4 communication
RUN apt-get update && apt-get install -y \
    ros-humble-mavros \
    ros-humble-mavros-extras \
    ros-humble-mavros-msgs \
    ros-humble-tf-transformations \
    && rm -rf /var/lib/apt/lists/*

# Install MAVROS geographic datasets
RUN wget https://raw.githubusercontent.com/mavlink/mavros/master/mavros/scripts/install_geographiclib_datasets.sh \
    && chmod +x install_geographiclib_datasets.sh \
    && ./install_geographiclib_datasets.sh \
    && rm install_geographiclib_datasets.sh

# Install Gazebo-ROS packages
RUN apt-get update && apt-get install -y \
    ros-humble-gazebo-ros-pkgs \
    ros-humble-gazebo-ros2-control \
    && rm -rf /var/lib/apt/lists/*

# Download PX4 source for Gazebo models (no build needed - just use models)
WORKDIR /opt
RUN git clone --depth 1 --branch v1.14.3 https://github.com/PX4/PX4-Autopilot.git px4_source \
    && cd px4_source \
    && git submodule update --init --recursive --depth 1 Tools/simulation/gazebo-classic/sitl_gazebo-classic

# Set up PX4 environment variables - use models without building plugins
ENV PX4_ROOT=/opt/px4_source
ENV GAZEBO_MODEL_PATH=/opt/px4_source/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models
ENV GAZEBO_PLUGIN_PATH=/usr/lib/x86_64-linux-gnu/gazebo-11/plugins

# Create simple launch script for Gazebo with Iris model
RUN echo '#!/bin/bash' > /usr/local/bin/launch_gazebo_iris.sh \
    && echo 'source /opt/ros/humble/setup.bash' >> /usr/local/bin/launch_gazebo_iris.sh \
    && echo 'export GAZEBO_MODEL_PATH=/opt/px4_source/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models' >> /usr/local/bin/launch_gazebo_iris.sh \
    && echo 'cd /opt/px4_source/Tools/simulation/gazebo-classic/sitl_gazebo-classic' >> /usr/local/bin/launch_gazebo_iris.sh \
    && echo 'gazebo --verbose -u worlds/empty.world --spawn_model_sdf iris iris /opt/px4_source/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models/iris/iris.sdf' >> /usr/local/bin/launch_gazebo_iris.sh \
    && chmod +x /usr/local/bin/launch_gazebo_iris.sh

# Create MAVROS launch script
RUN echo '#!/bin/bash' > /usr/local/bin/launch_mavros.sh \
    && echo 'source /opt/ros/humble/setup.bash' >> /usr/local/bin/launch_mavros.sh \
    && echo 'ros2 launch mavros px4.launch fcu_url:="udp://:14540@127.0.0.1:14557"' >> /usr/local/bin/launch_mavros.sh \
    && chmod +x /usr/local/bin/launch_mavros.sh

# Create symlinks for compatibility
RUN ln -sf /usr/bin/gazebo /usr/bin/gazebo11 \
    && ln -sf /usr/bin/gzserver /usr/bin/gzserver11 \
    && ln -sf /usr/bin/gzclient /usr/bin/gzclient11

# Create workspace directory
WORKDIR /root/drone_control_ws

# Copy source code
COPY src/ src/

# Initialize rosdep and install dependencies (continue even if some fail)
RUN rosdep init || true \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src -r -y || echo "Some dependencies failed to install, continuing..."

# Build the workspace (with fallback if build fails)
RUN . /opt/ros/humble/setup.sh \
    && colcon build --symlink-install || echo "Build completed with warnings"

# Set up entrypoint
RUN echo '#!/bin/bash' > /entrypoint.sh \
    && echo 'set -e' >> /entrypoint.sh \
    && echo 'source /opt/ros/humble/setup.bash' >> /entrypoint.sh \
    && echo 'source /root/drone_control_ws/install/setup.bash' >> /entrypoint.sh \
    && echo 'export GAZEBO_MODEL_PATH=/opt/px4_source/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models' >> /entrypoint.sh \
    && echo 'export GAZEBO_PLUGIN_PATH=/usr/lib/x86_64-linux-gnu/gazebo-11/plugins' >> /entrypoint.sh \
    && echo 'exec "$@"' >> /entrypoint.sh \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

# Expose common ports
EXPOSE 14540 14541 14542 14543 14544 14545
