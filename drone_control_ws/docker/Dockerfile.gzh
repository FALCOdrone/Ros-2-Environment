FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=humble \
    SHELL=/bin/bash \
    PX4_HOME=/opt/px4_source \
    GZ_VERSION=harmonic

# Install OS dependencies
RUN apt-get update && apt-get install -y \
    build-essential cmake git wget curl python3-pip python3-colcon-common-extensions \
    python3-rosdep lsb-release gnupg software-properties-common ninja-build \
    protobuf-compiler libprotobuf-dev python3-empy python3-jinja2 \
    python3-numpy python3-yaml python3-packaging python3-jsonschema \
    libeigen3-dev zip unzip \
    && rm -rf /var/lib/apt/lists/*

# Add Gazebo repository
RUN curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
    -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
      http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
    | tee /etc/apt/sources.list.d/gazebo-stable.list

# Install Gazebo Harmonic + ROS-GZ for Harmonic
RUN apt-get update && apt-get install -y \
    gz-harmonic \
    ros-humble-ros-gzharmonic \
    ros-humble-ros-gzharmonic-bridge \
    && rm -rf /var/lib/apt/lists/*

# Install ros2_control dependencies
RUN apt-get update && apt-get install -y \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    && rm -rf /var/lib/apt/lists/*

# Install PX4 dependencies
RUN pip3 install --user kconfiglib pyros-genmsg empy jinja2 packaging toml jsonschema future

# Clone PX4
WORKDIR /opt
RUN git clone --branch v1.14.3 https://github.com/PX4/PX4-Autopilot.git px4_source \
    && cd px4_source \
    && git fetch --tags \
    && git submodule update --init --recursive

# Build gz_ros2_control from source
RUN mkdir -p /root/gz_ros2_control_ws/src
WORKDIR /root/gz_ros2_control_ws/src
RUN git clone --branch humble https://github.com/ros-controls/gz_ros2_control.git
WORKDIR /root/gz_ros2_control_ws
RUN /bin/bash -lc "\
    source /opt/ros/$ROS_DISTRO/setup.bash && \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y --skip-keys=\"ros_gz_bridge ros_gz_sim\" && \
    colcon build --cmake-args -DGZ_VERSION=$GZ_VERSION \
"

# (Optional) Set up a workspace for your ROS code
WORKDIR /root/ros2_ws
RUN mkdir -p src

# Setup entrypoint
RUN echo '#!/bin/bash' > /entrypoint.sh \
    && echo 'set -e' >> /entrypoint.sh \
    && echo "source /opt/ros/$ROS_DISTRO/setup.bash" >> /entrypoint.sh \
    && echo "source /root/gz_ros2_control_ws/install/setup.bash" >> /entrypoint.sh \
    && echo 'exec "$@"' >> /entrypoint.sh \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
